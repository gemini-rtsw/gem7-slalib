#! /bin/sh -f
#
#  Install script for Gemini slalib library
#

if [ "`echo $EPICS | egrep 'GEM8\.5|GEM8\.6|GEM8\.7'`" != "" ]; then
    ppc=ppc604_long;
else
    ppc=ppc604;
fi

if [ "`echo $EPICS | egrep 'GEM8\.7'`" != "" ]; then
    applSetup.pl -T mv2700 -T $ppc -T sv3 -I src -I startup $1 > $2 2>&1
else
    applSetup.pl -T mv167 -T $ppc -I src -I startup $1 > $2 2>&1
fi

# gmake >> $2 2>&1

exit 0
